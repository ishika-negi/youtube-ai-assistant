{
  "manifest_version": 3,
  "name": "YouTube AI Assistant",
  "version": "1.0.0",
  "description": "Chat with YouTube videos using AI",

  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],

  "action": {
    "default_title": "YouTube AI Assistant"
  }
}